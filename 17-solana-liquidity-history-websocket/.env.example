# Data API key (required). Create one at https://www.solanatracker.io/account/data-api
ST_API_KEY=

# Datastream key or full wss:// URL (optional; Premium plan or higher). Without it the example runs the REST backfill only.
ST_DATASTREAM_KEY=

# Token mint to follow (default: the docs example token)
TOKEN_MINT=6p6xgHyF7AeE6TZkSmFsko444wqoP15icUSqi2jfGiPN

# Optional pool address: narrows history and the live room to one pool of TOKEN_MINT
POOL_ADDRESS=

# Number of history pages to backfill (1-20)
HISTORY_PAGES=3

# Rows per history page (1-500)
PAGE_LIMIT=100

# Set to true to add current wallet identity (REST enrich=identity, :enriched live room)
ENRICH_IDENTITY=false

# How often to reconcile provisional live events against confirmed REST history (seconds, min 10)
RECONCILE_INTERVAL_SECONDS=60

# Drop a live event from view if it is still missing from confirmed history after this many minutes
PROVISIONAL_TTL_MINUTES=5
