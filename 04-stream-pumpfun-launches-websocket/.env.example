# Data API key from https://www.solanatracker.io/account/data-api (used for the REST backfill)
ST_API_KEY=
# Datastream key or the full wss://datastream.solanatracker.io/<key> URL (Premium plan or higher)
ST_DATASTREAM_KEY=
# Only print launches whose bonding-curve pool has at least this much liquidity in USD
MIN_LIQUIDITY_USD=0
# Suppress repeat alerts for the same mint for this many minutes
DEDUPE_MINUTES=30
# Pages of GET /tokens/latest to read on each (re)connect, 0-10 (0 disables backfill)
BACKFILL_PAGES=1
