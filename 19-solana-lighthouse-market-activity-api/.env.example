# Data API key from https://www.solanatracker.io/account/data-api (required)
ST_API_KEY=
# Window for the leaderboard: 5m, 1h, 6h or 24h
LIGHTHOUSE_WINDOW=1h
# Rank markets by: volume, transactions, wallets, tokensCreated or migrations
SORT_METRIC=volume
# Number of markets to show (1-100)
TOP_N=10
# Include child launchpad markets (rows with a parent, e.g. meteora-curve:bags). true/false
INCLUDE_CHILD_MARKETS=false
# Refresh every N seconds (15-3600). 0 = fetch once and exit
WATCH_SECONDS=0
