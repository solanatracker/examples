# Data API key from https://www.solanatracker.io/account/data-api (required)
ST_API_KEY=
# Optional: Datastream key or full wss:// URL (Premium plan or higher). Leave empty for a one-off snapshot.
ST_DATASTREAM_KEY=
# Wallet to value (base58). Defaults to the docs sample wallet.
WALLET_ADDRESS=FbMxP3GVq8TQ36nbYgx4NP9iygMpwAwFWJwW81ioCiSF
# Hide holdings worth less than this many USD in the table (dust filter)
MIN_VALUE_USD=1
# Live mode only: re-fetch the REST snapshot this often to re-price holdings (seconds, minimum 30)
SNAPSHOT_REFRESH_SEC=300
# Optional: override the Data API host. Leave empty for the default.
DATA_API_BASE_URL=
