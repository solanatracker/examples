# Data API key from https://www.solanatracker.io/account/data-api (required)
ST_API_KEY=
# Optional text search: name, symbol or mint address. Empty = filters only
SEARCH_QUERY=
# Optional comma-separated market ids, e.g. pumpfun-amm,raydium,raydium-cpmm,meteora-dlmm. Empty = all markets
MARKETS=
# Minimum pool liquidity in USD
MIN_LIQUIDITY_USD=25000
# Minimum 24h volume in USD
MIN_VOLUME_24H_USD=50000
# Maximum risk score (1-10, higher = riskier)
MAX_RISK_SCORE=6
# Only tokens created in the last N hours. 0 = no age limit
MAX_AGE_HOURS=0
# Sort field (volume_24h, liquidityUsd, marketCapUsd, holders, createdAt, ...) and order (asc|desc)
SORT_BY=volume_24h
SORT_ORDER=desc
# Rows per request (1-500) and how many pages to fetch (1-20)
PAGE_SIZE=20
MAX_PAGES=3
