# Data API key (required). Create one at https://www.solanatracker.io/account/data-api
ST_API_KEY=

# Pump.fun token mint to analyze. Leave empty to use the top 24h-volume Pump.fun token from /search.
TOKEN_MINT=

# How many first buyers to fetch, 1-200 (default 50).
FIRST_BUYERS_LIMIT=50

# Wallets that exited within this many seconds of their first trade count as quick flips (default 300).
QUICK_FLIP_SECONDS=300

# Set to true to stream live sniper, insider and bundler changes after the report (needs ST_DATASTREAM_KEY).
WATCH_RISK=false

# Datastream key or full wss://datastream.solanatracker.io/<key> URL. Only used when WATCH_RISK=true (Premium plan or higher).
ST_DATASTREAM_KEY=
