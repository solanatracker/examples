# Yellowstone gRPC endpoint: https://grpc.solanatracker.io (EU) or https://grpc-us.solanatracker.io (US)
YELLOWSTONE_GRPC_ENDPOINT=
# x-token from https://www.solanatracker.io/account/yellowstone-grpc (sent as the x-token header)
YELLOWSTONE_GRPC_TOKEN=
# Stream commitment: processed (fastest, can roll back), confirmed or finalized
COMMITMENT=processed
