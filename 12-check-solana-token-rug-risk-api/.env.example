# Data API key from https://www.solanatracker.io/account/data-api (required)
ST_API_KEY=
# Token mint to check in detail. Leave empty to screen the current 1h trending list instead.
TOKEN_MINT=
# Fail tokens whose risk score is above this value (1-10 scale, higher = riskier)
MAX_RISK_SCORE=6
# Fail when snipers hold more than this percent of supply
MAX_SNIPER_PCT=20
# Fail when insiders hold more than this percent of supply
MAX_INSIDER_PCT=20
# Fail on any factor with level "danger" (true/false)
BLOCK_DANGER_FACTORS=true
