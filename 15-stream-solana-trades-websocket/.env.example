# Datastream key or full wss:// URL (required; Premium plan or higher). Found in the Data API dashboard.
ST_DATASTREAM_KEY=

# Data API key (required) for the REST backfill and reconnect gap fill. https://www.solanatracker.io/account/data-api
ST_API_KEY=

# Token whose trades are streamed (default: the docs example token)
TOKEN_MINT=6p6xgHyF7AeE6TZkSmFsko444wqoP15icUSqi2jfGiPN

# Optional pool address: stream and backfill only this pool of TOKEN_MINT
POOL_ADDRESS=

# Only print trades with at least this USD volume (0 prints everything)
MIN_USD=0

# Trades per REST page for the backfill and gap fill (1-500)
BACKFILL=25

# Set to true to join the :enriched room and request identity on REST (wallet labels)
ENRICHED=false

# Seconds between stats lines
STATS_SECONDS=30

# Optional Data API base URL override (default: https://data.solanatracker.io)
DATA_API_BASE_URL=
