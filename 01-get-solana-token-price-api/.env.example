# Data API key (required). Create one at https://www.solanatracker.io/account/data-api
ST_API_KEY=

# Token whose pools and price snapshot are printed (default: wrapped SOL)
TOKEN_MINT=So11111111111111111111111111111111111111112

# Optional comma-separated mints for the batch price table (default: SOL, USDC, JUP, BONK)
WATCHLIST=

# Optional Data API base URL override (default: https://data.solanatracker.io)
DATA_API_BASE_URL=
