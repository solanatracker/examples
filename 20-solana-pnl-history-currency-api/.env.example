# Data API key from https://www.solanatracker.io/account/data-api (required)
ST_API_KEY=
# Wallet to analyze (base58). Defaults to the sample wallet used in the PnL v2 docs.
WALLET_ADDRESS=CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o
# Denomination for monetary fields: usd, sol or eur
PNL_CURRENCY=usd
# Window for history and performance: 1d, 7d, 14d, 30d, 90d or all
PNL_PERIOD=30d
# Summary only: how flagged positions count toward realized PnL (strict, adjusted or raw)
PNL_MODE=strict
# How many of the most recent history days to print (1-1000)
HISTORY_ROWS=14
# Give up polling a queued wallet after this many seconds
PNL_QUEUE_MAX_WAIT_SEC=120
# Optional: override the Data API host. Leave empty for the default.
DATA_API_BASE_URL=
