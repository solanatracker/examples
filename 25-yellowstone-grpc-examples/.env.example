# Yellowstone gRPC endpoint and x-token: https://www.solanatracker.io/account/yellowstone-grpc
YELLOWSTONE_GRPC_ENDPOINT=
YELLOWSTONE_GRPC_TOKEN=

# Optional: processed (default, fastest), confirmed or finalized
GRPC_COMMITMENT=processed

# Only for the decode recipe: any RPC URL that serves getTransaction
SOLANA_RPC_URL=

# Only for the notify recipe. Without them it prints the messages instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
