# Optional: Raptor host. Leave unset for the hosted API; set it when self-hosting the binary.
RAPTOR_BASE_URL=

# Optional: any Solana RPC URL. Used for mint decimals, lookup tables and the compiled-size check.
# Defaults to the public mainnet endpoint, which is rate-limited.
SOLANA_RPC_URL=

# Order to compare. Defaults: wrapped SOL -> USDC, 25 SOL in base units, 50 bps slippage.
INPUT_MINT=
OUTPUT_MINT=
AMOUNT=
SLIPPAGE_BPS=50

# Mode used by EXECUTE: auto (default), true or false
JIT_MODE=auto

# Priority fee level: min, low, auto, medium, high, veryHigh, turbo or unsafeMax
PRIORITY_FEE=medium

# Optional: build for this address instead of a throwaway one (nothing is signed)
WALLET_PUBLIC_KEY=

# DANGER: with EXECUTE=true and an explicit AMOUNT, the script signs and sends a real mainnet swap.
# Base58 secret key. Use a dedicated wallet with a small balance.
WALLET_SECRET_KEY=
EXECUTE=false
CONFIRM_TIMEOUT_SEC=60
