# Data API key from https://www.solanatracker.io/account/data-api (used for GET /tokens/multi/graduated)
ST_API_KEY=
# Datastream key or the full wss://datastream.solanatracker.io/<key> URL (Premium plan or higher)
ST_DATASTREAM_KEY=
# Bonding-curve percentage that puts a Pump.fun token on the watchlist (integer 1-100)
CURVE_THRESHOLD=90
# Rows of GET /tokens/multi/graduated to check on start and after each reconnect (0-500, 0 disables)
BACKFILL_LIMIT=50
# Pass reduceSpam to the graduated endpoint to drop quick-graduated tokens (true/false)
REDUCE_SPAM=true
# Drop watchlist entries that have not graduated after this many hours
WATCH_TTL_HOURS=6
