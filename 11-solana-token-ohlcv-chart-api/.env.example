# Data API key (required). Create one at https://www.solanatracker.io/account/data-api
ST_API_KEY=

# Token to chart (default: wrapped SOL)
TOKEN_MINT=So11111111111111111111111111111111111111112

# Optional pool address: chart one pool instead of the token's main pool over time
POOL_ADDRESS=

# Candle interval: 1s 5s 15s 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d 3d 1w 1mn
CHART_INTERVAL=1h

# How many days back to fetch
CHART_DAYS=7

# Quote currency for candles: usd, eur or sol
CHART_CURRENCY=usd

# Set to true for market-cap candles instead of price candles
MARKET_CAP=false

# Set to true to fill missing intervals with flat zero-volume candles
FILL_GAPS=false

# Candles per request window when splitting long ranges (client-side choice, not a server limit)
WINDOW_CANDLES=1000

# Number of most recent candles to print
SHOW_LAST=12

# Optional Data API base URL override (default: https://data.solanatracker.io)
DATA_API_BASE_URL=
