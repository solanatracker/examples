# Data API key from https://www.solanatracker.io/account/data-api (required)
ST_API_KEY=
# Token whose trades and holders to label (base58 mint). Defaults to the token used in the docs examples.
TOKEN_MINT=6p6xgHyF7AeE6TZkSmFsko444wqoP15icUSqi2jfGiPN
# Swaps to fetch with identity enrichment (1-500)
LIMIT=100
# Rows to print in each table
SHOW_ROWS=25
# Optional: override the Data API host. Leave empty for the default.
DATA_API_BASE_URL=
