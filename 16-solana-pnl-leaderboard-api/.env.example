# Data API key from https://www.solanatracker.io/account/data-api (required)
ST_API_KEY=
# Rolling window in days: 1, 7, 30 or 90
LEADERBOARD_DAYS=30
# Rank by: realized, volume, days, roi, win_percentage, trades or tokens
LEADERBOARD_SORT=realized
# How flagged positions count toward realized PnL: strict, adjusted or raw
PNL_MODE=strict
# Rows per page for the top-trader table (1-100); KOL tables show up to 10
LIMIT=20
# Pages to follow with nextCursor (1-5)
PAGES=1
# Set to false to include wallets flagged as arbitrage bots
EXCLUDE_ARBITRAGE=true
# Optional: comma-separated platforms (axiom, axiom-flash, bloom, photon). Empty = all.
PLATFORM=
# Optional: minimum trades in the window. Empty = API default.
MIN_TRADES=
# Optional: minimum active trading days. Empty = API default.
MIN_DAYS=
# Optional: max share of PnL from a single token, in percent. Empty = no filter.
MAX_SINGLE_TOKEN_PCT=
# Optional: override the Data API host. Leave empty for the default.
DATA_API_BASE_URL=
