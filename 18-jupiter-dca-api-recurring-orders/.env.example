# Required. Data API key from https://www.solanatracker.io/account/data-api
ST_API_KEY=

# Optional. Datastream key or the full wss:// URL from the dashboard (Premium plan or higher).
# Leave empty to run only the REST snapshot.
ST_DATASTREAM_KEY=

# Optional. Token mint to analyse. Defaults to wrapped SOL.
TOKEN_MINT=So11111111111111111111111111111111111111112

# Optional. Owner wallet to summarise with its DCA orders.
WALLET_ADDRESS=

# Optional. buyers (token is the output), sellers (token is the input) or both. Default both.
SIDE=both

# Optional. active, paused, completed, pending or all. Default active.
STATUS=active

# Optional. volume, deposited, remaining, progress, recent, created or status. Default volume.
SORT=volume

# Optional. Orders per page for the token endpoints, 1-1000. Default 100.
PAGE_LIMIT=100

# Optional. Pages to read per side, 1-10. Default 2.
MAX_PAGES=2
