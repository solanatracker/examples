# Datastream key or full wss:// URL (required; Premium plan or higher). Found in the Data API dashboard.
ST_DATASTREAM_KEY=

# Data API key (required) for the REST snapshot on connect and reconnect. https://www.solanatracker.io/account/data-api
ST_API_KEY=

# Token to stream through the aggregated price room (default: wrapped SOL)
TOKEN_MINT=So11111111111111111111111111111111111111112

# Optional pool address: also streams that single pool's price room
POOL_ADDRESS=

# Warn and refresh over REST after this many seconds without a price message
STALE_AFTER_SECONDS=30

# Print at most one line per series per this many milliseconds
PRINT_INTERVAL_MS=1000

# Optional Data API base URL override (default: https://data.solanatracker.io)
DATA_API_BASE_URL=
