# Full RPC URL including ?api_key=... (https://www.solanatracker.io/account/shared-rpc). Used when RPC_URLS is empty.
SOLANA_RPC_URL=
# Optional: comma-separated list of RPC URLs to compare side by side. Overrides SOLANA_RPC_URL.
RPC_URLS=
# Measured rounds per endpoint (each round = 1 getSlot + 1 getLatestBlockhash). Use 100+ for a meaningful p99.
SAMPLES=20
# Per-request timeout in milliseconds. Timeouts count as errors, not as latency samples.
TIMEOUT_MS=5000
# Pause between rounds in milliseconds. 400 keeps one endpoint under 5 requests per second.
INTERVAL_MS=400
# Commitment for both methods: processed, confirmed or finalized.
COMMITMENT=confirmed
