# Raptor needs no API key. Defaults to https://raptor.solanatracker.io; override only if you self-host the binary.
RAPTOR_BASE_URL=

# Swap pair as mint addresses (defaults: wrapped SOL → USDC)
INPUT_MINT=So11111111111111111111111111111111111111112
OUTPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Input amount in base units: lamports for SOL (10000000 = 0.01 SOL), 6-decimal units for USDC
AMOUNT=10000000

# "dynamic" lets the router pick slippage from volatility and route complexity; or an integer in bps (50 = 0.5%)
SLIPPAGE_BPS=dynamic

# Routing: 1-4 hops; optional comma-separated DEX filter (e.g. raydium,meteora,pumpfun)
MAX_HOPS=4
DEXES=

# Priority fee level (min, low, auto, medium, high, veryHigh, turbo, unsafeMax) or an exact compute unit price in microlamports; optional cap
PRIORITY_FEE=medium
MAX_PRIORITY_FEE=

# Optional: build the unsigned transaction for this wallet (dry run, nothing is signed or sent)
WALLET_PUBLIC_KEY=

# DANGER: with EXECUTE=true the swap is signed with this key and sent on mainnet. Spends real funds.
# Base58-encoded 64-byte secret key (the format Phantom and solana-keygen export). Never commit this file.
WALLET_SECRET_KEY=
EXECUTE=false

# How long to poll /transaction/:signature before giving up
CONFIRM_TIMEOUT_SEC=60
