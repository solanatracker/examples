# Yellowstone gRPC endpoint: https://grpc.solanatracker.io (EU) or https://grpc-us.solanatracker.io (US)
YELLOWSTONE_GRPC_ENDPOINT=
# x-token from https://www.solanatracker.io/account/yellowstone-grpc (sent as the x-token header)
YELLOWSTONE_GRPC_TOKEN=
# Wallet whose SOL and token balances to stream
WALLET_ADDRESS=FbMxP3GVq8TQ36nbYgx4NP9iygMpwAwFWJwW81ioCiSF
# Optional: RPC URL for the starting snapshot, reconnect backfill and mint decimals
SOLANA_RPC_URL=
# Stream commitment: processed, confirmed or finalized
COMMITMENT=confirmed
